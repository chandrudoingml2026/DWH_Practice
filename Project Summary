AccountType -> TRIM()
Balance -> Direct
CreditScore -> Direct
Currency -> UPPER()
CustomerID -> Direct
DateOpened -> Direct
ManagerID -> Direct
ODLimit -> Direct
load_dt -> Current date
load_ts -> Current timestamp

TRIM(AccountType) removes unwanted spaces.

Example:
' SAVINGS ' -> 'SAVINGS'

UPPER(Currency) converts:
usd -> USD
inr -> INR
eur -> EUR

