4. ACCOUNTS ODS LOAD

SQL:
INSERT INTO odsdb_chandb.ods_accounts
SELECT AccountID,
       trim(AccountType),
       Balance,
       CreditScore,
       upper(Currency),
       CustomerID,
       DateOpened,
       ManagerID,
       ODLimit,
       CURRENT_DATE AS load_dt,
       CURRENT_TIMESTAMP AS load_ts
FROM chandb.stg_accounts
WHERE AccountID IS NOT NULL;

SOURCE:
chandb.stg_accounts

TARGET:
odsdb_chandb.ods_accounts

TRANSFORMATIONS:
